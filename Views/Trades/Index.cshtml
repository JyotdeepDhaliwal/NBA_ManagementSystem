<div class="d-flex justify-content-between align-items-center my-4">
    <h2 class="fw-bold text-danger"><i class="bi bi-arrow-left-right"></i> Trade History</h2>
</div>

<div class="table-responsive shadow rounded bg-white">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Trade Name</th>
                <th>Player</th>
                <th>From Team</th>
                <th>To Team</th>
                <th>Contract</th>
                <th>Trade Value</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trade in trades)
            {
                <tr>
                    <td>@trade.Name</td>
                    <td><span class="badge bg-primary text-white p-2">@trade.Player</span></td>
                    <td><span class="text-muted">@trade.From</span></td>
                    <td><span class="text-muted">@trade.To</span></td>
                    <td><span class="badge bg-info text-dark">@trade.Contract</span></td>
                    <td><span class="text-success fw-bold">$@String.Format("{0:N0}", trade.Value)</span></td>
                    <td>@trade.Date</td>
                </tr>
            }
        </tbody>
    </table>
</div>
