            Player = "Kevin Durant",
            From = "Oklahoma City Thunder",
            To = "Golden State Warriors",
            Contract = "2-year deal",
            Value = 54300000,
            Date = "July 4, 2016"
        },
        new { 
            Name = "2017: Kyrie Irving to Celtics", 
            Player = "Kyrie Irving", 
            From = "Cleveland Cavaliers", 
            To = "Boston Celtics", 
            Contract = "2-year deal", 
            Value = 39000000, 
            Date = "August 22, 2017" 
        },

        new { 
            Name = "2019: Anthony Davis to Lakers", 
            Player = "Anthony Davis", 
            From = "New Orleans Pelicans", 
            To = "Los Angeles Lakers", 
            Contract = "5-year deal", 
            Value = 189000000, 
            Date = "July 6, 2019" 
        },

        new { 
            Name = "2021: James Harden to Nets",
            Player = "James Harden", 
            From = "Houston Rockets", 
            To = "Brooklyn Nets", 
