@model IEnumerable<NBA_ManagementSystem.Models.UserTeam>

@{
    ViewBag.Title = "My Custom Teams";
}

<style>
    .team-card {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 25px;
        padding: 20px;
    }

    .team-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: bold;
        font-size: 1.3rem;
        margin-bottom: 10px;
        color: #0d6efd;
    }

    .team-actions {
        display: flex;
        gap: 10px;
    }

        .team-actions form {
            display: inline;
        }

    .btn-sm {
        padding: 4px 10px;
        font-size: 0.9rem;
    }

    .no-players {
        color: #6c757d;
        font-style: italic;
        margin-left: 10px;
    }

    .team-players li {
        margin-bottom: 4px;
    }

    .make-team-link {
        display: inline-block;
        margin-top: 30px;
        font-weight: 600;
        color: #0d6efd;
        text-decoration: none;
    }

        .make-team-link:hover {
            text-decoration: underline;
        }
</style>

<h2 class="mb-4 fw-bold text-dark">My Custom Teams</h2>

@foreach (var team in Model)
{
    <div class="team-card">
        <div class="team-header">
            @team.TeamName
            <div class="team-actions">
                @Html.ActionLink("Edit", "EditTeam", "Teams", new { id = team.Id }, new { @class = "btn btn-sm btn-info" })

                @using (Html.BeginForm("DeleteTeam", "Teams", FormMethod.Post))
                {
                    @Html.Hidden("id", team.Id)
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this team and its players?')">
                        Remove
                    </button>
                }
            </div>
        </div>
        <div class="team-body">
            @if (team.Players != null && team.Players.Any())
            {
                <ul class="team-players">
                    @foreach (var player in team.Players)
                    {
                        <li>@player.PlayerName (@player.Position, @player.Height)</li>
                    }
                </ul>
            }
            else
            {
                <p class="no-players">No players added yet.</p>
            }
        </div>
    </div>
}

<p>
    @Html.ActionLink("Click Me To Make Team Name", "CreateOwnTeam", null, new { @class = "make-team-link" })
</p>
