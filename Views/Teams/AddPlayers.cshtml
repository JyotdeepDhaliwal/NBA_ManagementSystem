@model List<NBA_ManagementSystem.Models.UserTeamPlayer>
@{
    ViewBag.Title = "Add Players";
}

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h2 class="text-primary mb-4 text-center">
            <i class="bi bi-person-plus-fill me-2"></i> Add Players to <span class="text-dark">@ViewBag.TeamName</span>
        </h2>

        @using (Html.BeginForm("AddPlayers", "Teams", FormMethod.Post))
        {
            <input type="hidden" name="teamId" value="@ViewBag.TeamId" />

            <div class="mb-3 text-center">
                <label class="form-label fw-bold d-block text-start">Player Name</label>
                <input type="text" name="playerName" class="form-control" placeholder="Enter player name" required />
            </div>

            <div class="mb-3 text-center">
                <label class="form-label fw-bold d-block text-start">Position</label>
                <input type="text" name="position" class="form-control" placeholder="Enter position (e.g. Point Guard)" />
            </div>

            <div class="mb-3 text-center">
                <label class="form-label fw-bold d-block text-start">Height</label>
                <input type="text" name="height" class="form-control" placeholder="e.g. 6 ft 8 in" />
            </div>

            if (ViewBag.Error != null)
            {
                <p class="text-danger text-center fw-bold">@ViewBag.Error</p>
            }

            <button type="submit" class="btn btn-success w-100 fw-bold">Add Player</button>
        }
    </div>

    <hr class="my-5" />

    <h4 class="mb-3">Current Players</h4>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Height</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model)
                {
                    <tr>
                        <td>@player.PlayerName</td>
                        <td>@player.Position</td>
                        <td>@player.Height</td>
                        <td>
                            @using (Html.BeginForm("DeletePlayer", "Teams", FormMethod.Post))
                            {
                                @Html.Hidden("id", player.Id)
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No players have been added yet.</p>
    }

    <div class="mt-3">
        @Html.ActionLink("Back to My Teams", "MyTeams", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
