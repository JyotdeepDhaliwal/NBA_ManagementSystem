<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - NBA Management</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/site-custom.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">



</head>
<body>
    <div class="wrapper d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                @Html.ActionLink("🏀 NBA Managment System", "Index", "Home", null, new { @class = "navbar-brand fw-bold" })

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown"
                        aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Teams", "Index", "Teams", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Players", "Index", "Players", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Trades", "Index", "Trades", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Search", "Search", "Players", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Create Team", "CreateOwnTeam", "Teams", null, new { @class = "nav-link" })</li>


                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">@Html.ActionLink("Create Player", "Create", "Players", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Create Team", "Create", "Teams", null, new { @class = "nav-link" })</li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @Html.Partial("_UserInfo")
                    </ul>
                </div>
            </div>
        </nav>


        <main class="container flex-grow-1 mt-4">
            @RenderBody()
        </main>


        @*<main class="container flex-grow-1 mt-4">
            <div class="row">
                <div class="col-md-3">
                    @Html.Partial("_Sidebar")
                </div>
                <div class="col-md-9">
                    @RenderBody()
                </div>
            </div>
        </main>*@

        @*<div class="container mt-4">
            <div class="row">
                <div class="col-md-3">
                    @Html.Partial("_Sidebar")
                </div>
                <div class="col-md-9">
                    @RenderBody()
                </div>
            </div>
        </div>*@

        @*<footer class="text-center mt-4">
            <p>&copy; @DateTime.Now.Year - NBA Management</p>
        </footer>*@

        <!-- Footer Section -->
        <footer class="bg-dark text-white text-center py-3">
            <div>
                <a href="https://www.nba.com/" target="_blank" class="text-white">NBA Official Website</a> |
                <a href="https://www.espn.com/nba/" target="_blank" class="text-white">ESPN NBA</a> |
                <a href="https://www.sports.yahoo.com/nba/" target="_blank" class="text-white">Yahoo Sports NBA</a> |
                <a href="https://www.si.com/nba" target="_blank" class="text-white">Sports Illustrated NBA</a>
            </div>
            <div class="mt-2">
                <p>&copy; 2024 NBA Management System | All Rights Reserved</p>
            </div>
        </footer>
    </div>

        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/jqueryval")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)

</body>

</html>
